auto-update = off

font-family = "JetBrainsMonoNL NF Regular"
font-family-italic = "JetBrainsMonoNL NF Italic"
font-family-bold = "JetBrainsMonoNL NF Bold"
font-family-bold-italic = "JetBrainsMonoNL NF Bold Italic"
font-size = 14
font-feature = -calt, -liga, -dlig

cursor-opacity = 0.65
cursor-style = block 
cursor-style-blink = false
shell-integration-features = no-cursor
mouse-hide-while-typing = true

# Toggle full screen with fn + f on mac
window-width = 170
window-height = 46
window-save-state = never
window-position-x = 33
window-position-y = 27

# May reduce performance
#background-opacity = 0.9
# The default blur is 20
#background-blur = true

macos-titlebar-style = tabs

# Darker colours 0 - 7
palette = 0=#000000
palette = 1=#cc4444
palette = 2=#44cc44
palette = 3=#cccc44
palette = 4=#4444cc
palette = 5=#cc44cc
palette = 6=#8ef9fd
palette = 7=#cdcdcd

# Bright colors (8-15)
palette = 8=#444444
palette = 9=#cc4444
palette = 10=#44cc44
palette = 11=#cccc44
palette = 12=#4444cc
palette = 13=#cc44cc
palette = 14=#8ef9fd
palette = 15=#ffffff


#font-thicken = true
#font-thicken-strength = 100
theme = Catppuccin Mocha
#theme = Catppuccin Macchiato
#background = 000000

# macos-option-as-alt = right
# Keybinds 
keybind = super+a=text:\x1ba
keybind = super+s=text:\x1bs
keybind = super+d=text:\x1bd
# The following keybind can be enabled but will disable the search functionality 
# keybind = super+f=text:\x1bf 

tab-inherit-working-directory = true

# tmux-like multiplexing: Ctrl+Space is the prefix (leader), then a key
# Splits (tmux: % and ")
keybind = ctrl+space>shift+5=new_split:right
keybind = ctrl+space>v=new_split:down

# Pane navigation (vim directions)
keybind = ctrl+space>h=goto_split:left
keybind = ctrl+space>j=goto_split:down
keybind = ctrl+space>k=goto_split:up
keybind = ctrl+space>l=goto_split:right
keybind = ctrl+space>o=goto_split:next

# Pane management
keybind = ctrl+space>z=toggle_split_zoom
keybind = ctrl+space>x=close_surface
keybind = ctrl+space>equal=equalize_splits

# Windows (tabs)
keybind = ctrl+space>c=new_tab
keybind = ctrl+space>p=previous_tab
keybind = ctrl+space>1=goto_tab:1
keybind = ctrl+space>2=goto_tab:2
keybind = ctrl+space>3=goto_tab:3
keybind = ctrl+space>4=goto_tab:4
keybind = ctrl+space>5=goto_tab:5
keybind = ctrl+space>6=goto_tab:6
keybind = ctrl+space>7=goto_tab:7
keybind = ctrl+space>8=goto_tab:8
keybind = ctrl+space>9=goto_tab:9

# Press the prefix twice to send a literal Ctrl+Space to the terminal
keybind = ctrl+space>ctrl+space=text:\x00

# New splits open in the current directory
split-inherit-working-directory = true

# Optional: dim unfocused splits so you can see which one is active
unfocused-split-opacity = 0.85

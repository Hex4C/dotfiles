{
  "debugLog": false,
  "permissionReviewLog": false,
  "yoloMode": false,
  "permission": {
    "*": "allow",
    "write": "ask",
    "edit": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "sudo *": "ask",
      "git *": "ask",
      "git diff": "ask",
      "git status": "allow"
    },
    "external_directory": "ask",
    "external_directory_read": { "~/.pi/agent/skills/*": "allow" }
  }
}
